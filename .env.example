# Kopiere diese Datei nach ".env" und trage deine Werte ein.
# ACHTUNG: .env niemals committen (steht in .gitignore).

# Adresse der Vault-/OpenBao-Instanz (ohne /ui, ohne Pfad):
VAULT_ADDR=https://emea02-prod.rb-secrets.app.bosch.com:8200

# Namespace (aus der UI-URL, Parameter ?namespace=...):
VAULT_NAMESPACE=hv_066ee8cc-119b-48f0-b056-f1f0872cb46c

# Token: in der Web-UI oben rechts auf dein Profil -> "Copy token".
# Kurzlebig! Bei "permission denied / 403" hier ein frisches Token eintragen.
VAULT_TOKEN=

# Optional: Pfad zu einem CA-Bundle, falls truststore nicht genutzt wird.
# VAULT_CACERT=C:\pfad\zur\bosch-ca.pem
